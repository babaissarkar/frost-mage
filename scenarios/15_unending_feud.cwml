#textdomain wesnoth-Frost_Mage

[scenario]
	id=15_unending_feud
	name=_"Unending Feud"
	map_file="~add-ons/Frost_Mage/maps/15_unending_feud.map"
	{TURNS 20 17 15}
	victory_when_enemies_defeated=no
	next_scenario=16_a_swampy_day

	{DEFAULT_SCHEDULE}

	[label]
		x,y=12,8
		text= _ "Noct"
	[/label]
	[label]
		x,y=29,10
		text= _ "R. Siverrill"
	[/label]
	[label]
		x,y=37,16
		text= _ "Diurna"
	[/label]
	[item]
		x,y=53,20
		image=scenery/signpost.png
	[/item]

	[side]
		side=1
		controller=human
		team_name=good
		no_leader=yes
		{INCOME 0 0 0}
		{GOLD 120 100 100}
		village_gold=0
		fog=yes
		shroud=yes
		team_name=erinna
		user_team_name= _ "Elves"
		recruit = Elvish Hero, Elvish Ranger, Elvish Rider, Elvish Captain, Elvish Marksman
		[leader]
			# wmllint: recognize eliel
			{CHARACTER_STATS:ELIEL}
			x,y=2,1
			type=Elvish Lady Marshal
			canrecruit=yes
			facing=se
		[/leader]
		[unit]
			# wmllint: recognize kalenz
			id=kalenz
			type=Elvish High Lord
			name= _ "Mysterious Lord"
			placement=leader
			facing=se
			profile="portraits/elves/hidden-elflord.webp"
			[modifications {TRAIT_AGED}]
			[abilities leadership]
		[/unit]
		[unit]
			# wmllint: recognize liyesa
			id=liyesa
			name= _ "Liyesa"
			type=Elvish Lady
			placement=leader
			facing=se
			profile="portraits/elves/joafm-druid.webp"
		[/unit]
		[unit]
			# wmllint: recognize mage
			id=mage
			side=1
			type=Mage
			placement=leader
			facing=se
			[modifications {TRAIT_LOYAL}]
		[/unit]
	[/side]

	[side]
		side=2
		controller=ai
		team_name=noct
		no_leader=yes
		user_team_name= _ "Noct Undead"
		hidden=yes
	[/side]

	[side]
		side=3
		controller=ai
		team_name=diurna
		no_leader=yes
		user_team_name= _ "Diurna Undead"
		hidden=yes
	[/side]

	[event]
		#1 19/14 2/26 5
		name=side 2 turn
		first_time_only=no

		# Normal Difficulty: any one of two L1, one L2
		{RANDOM_UNDEAD 1 19 2 TYPE="Ghoul,Skeleton,Bone Shooter"}
		{RANDOM_UNDEAD 14 2 2 TYPE="Thrall,Skeleton Archer,Revenant"}
		{RANDOM_UNDEAD 26 5 2 TYPE="Ghost,Skeleton,Iron Thrall"}
		{RANDOM_UNDEAD 17 7 2 TYPE="Necrophage,Thrall,Wraith"}
	[/event]

	[event]
		#1 19/14 2/26 5
		name=side 3 turn
		first_time_only=no

		# Normal Difficulty: any one of two L1, one L2
		{RANDOM_UNDEAD 30 20 3 TYPE="Ghost,Skeleton,Iron Thrall"}
		{RANDOM_UNDEAD 37 10 3 TYPE="Ghoul,Skeleton,Bone Shooter"}
		{RANDOM_UNDEAD 50 10 3 TYPE="Necrophage,Thrall,Wraith"}
		{RANDOM_UNDEAD 47 8 3 TYPE="Thrall,Skeleton Archer,Revenant"}
	[/event]

	[event]
		name=start

		[set_variable]
			name=all_passed
			value=0
		[/set_variable]

		{MAKE_HERO kalenz}
		{MAKE_HERO liyesa}
		{MAKE_HERO mage}

		{MSG eliel (_"This is bad. We must cross this river fast, or the black ones will soon catch us.")}
		{MSG kalenz (_"One of your friends can fly and the other can walk on water. But we can do neither. So the only way for us is through these cities. The bridge should still be intact. ")}
		{MSG eliel (_"You sent them to delay the attackers, while we cross the river using the bridge?")}
		{MSG kalenz (_"Correctly said. They can cross the river anywhere. Not us. We must take the most perilous route. Time and fate are not in our favour.")}
		{MSG liyesa (_"I don't like the looks of this city. It feels bad, evil.")}
		{MSG eliel (_"Our scouts have spotted unnatural silhouettes. Could only be undead.")}
		{MSG kalenz (_"(<i>Sighs</i>) Yes, those are undead. Some you fought before, and some are different.")}
		{MSG kalenz (_"There is yet another thing I must tell you before we proceed.")}
		{MSG liyesa (_"Ancestor, is that necessary? You don't like that, do you?")}
		{MSG kalenz (_"(<i>Sad</i>) I must, this time, young lady. Our survival may depend on it.")}
		{MSG kalenz (_"(<i>Lowers his hood</i>)")}

		[delay time=50]
		[modify_unit]
			[filter id=kalenz]
			name= _ "Kalenz"
			profile="portraits/elves/kalenz.png~FL()"
		[/modify_unit]

		{STORE mage KILL=no}
		{MSG kalenz (_"My name is <i>Kalenz</i>.")}
		{MSG narrator (_"The group lost their speech for a while. Then finally $mage.name spoke.")}
		{MSG mage (_"My lord, you mean the same person who helped Prince Konrad the first? That was <i>hundreds of years ago</i>!")}
		[delay time=50]
		{MSG kalenz (_"(<i>Extreme sadness</i>) Such... is the nature of my <i>curse</i>.")}
		{MSG kalenz (_"I have developed some sort of awareness regarding the Undead. I can tell you before they arrive. But, I may also become one of them... if we stay close to the Undead for long.")}
		{MSG kalenz (_"If I do that, strike me down or leave me behind. I do not mind.")}
		{MSG liyesa (_"No, ancestor, no! Don't say such horrible words.")}
		{MSG eliel (_"Let us just hope we don't come to that.")}
		{MSG mage (_"I would prefer not to fight someone out of books. Enough confusion already!")}

		[objectives]
			side=1
			[objective]
				description= _ "Cross the cities and find the way out."
				condition=win
			[/objective]
			[objective]
				description= _ "Death of Heros."
				condition=lose
			[/objective]

			{TURNS_RUN_OUT}
		[/objectives]
	[/event]

	[event]
		name=moveto
		first_time_only=yes
		[filter]
			side=1
			[filter_location x,y=46-48,16-18]
		[/filter]

		{MSG unit (_"I can see the exit! Everyone, hurry!")}
		{HIGHLIGHT_IMAGE 53 20 scenery/signpost.png ()}

		# so we can use their names in the objectives below
		{STORE liyesa KILL=no}
		{STORE kalenz KILL=no}
		{STORE mage KILL=no}
		{STORE eliel KILL=no}

		[objectives]
			side=1
			[objective]
				description= _ "All heros must reach the signpost."
				condition=win
			[/objective]
			[objective]
				description= _ "Death of Heros."
				condition=lose
			[/objective]
			[note]
				description= _ "The heroes are: $eliel.name, $kalenz.name, $liyesa.name, $mage.name."
			[/note]
			{TURNS_RUN_OUT}
		[/objectives]
	[/event]

	[event]
		name=enter_hex
		first_time_only=no

		[filter]
			side=1
			[filter_location terrain=Rp^Vhcr]
		[/filter]

		{MSG kalenz (_ "Do not go there, buildings have undead inside!")}

		[cancel_action /]

		[move_unit]
			id=$unit.id
			to_x=$x2
			to_y=$y2
		[/move_unit]
	[/event]

	# Win event
	[event]
		name=moveto
		first_time_only=no
		[filter]
			id=eliel,kalenz,liyesa,mage
			[filter_location x,y=53,20]
		[/filter]

		[if]
			[variable]
				name=unit.id
				equals=eliel
			[/variable]
			[then]
				[if]
					[variable]
						name=all_passed
						equals=3
					[/variable]
					[then]
						{CLEAR_VARIABLE all_passed}
						[endlevel]
							result=victory
							carryover_percentage=0
							carryover_add=no
							bonus=no
						[/endlevel]
					[/then]
					[else]
						[move_unit]
							id=eliel
							to_x=53
							to_y=21
						[/move_unit]
						{MSG eliel _"Go, everyone. I'll go last."}
					[/else]
				[/if]
			[/then]
			[else]
				{STORE $unit.id KILL=yes}
				{UNSTORE $unit.id "recall" "recall"}
				[set_variable]
					name=all_passed
					add=1
				[/set_variable]
			[/else]
		[/if]
	[/event]

	{DEATH_EVENT (liyesa,kalenz,eliel,mage)}
	{TIMEOUT_EVENT}
[/scenario]